def _pal() -> dict:
    """현재 테마 팔레트를 반환 (런타임에 매번 참조 → 테마 전환 즉시 반영)."""
    return _core.THEME_PALETTES.get(_core.CURRENT_THEME,
                                    _core.THEME_PALETTES["light"])


