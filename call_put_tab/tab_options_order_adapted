"""
tab_options_order_adaptive.py — IBKR Adaptive Algorithm 전용 모듈  v1.0
════════════════════════════════════════════════════════════════════════
  OrderMixin 에 mixin되어 어댑티브 기능을 제공한다.

  포함 기능:
  - _build_adaptive_ui(tif_row)   TIF 행에 체크박스 + 콤보 위젯 삽입
  - _apply_adaptive(ibord)        IbOrder 객체에 algoStrategy 적용
  - _adaptive_label()             확인 다이얼로그 / 상태바용 태그 문자열 반환
════════════════════════════════════════════════════════════════════════
"""

from PyQt5.QtWidgets import QCheckBox, QComboBox, QLabel


class AdaptiveMixin:
    """
    IBKR Adaptive Algorithm UI + 로직.
    OrderMixin(AdaptiveMixin) 형태로 mixin된다.

    사용하는 위젯 (self 에 바인딩):
        self.chk_adaptive          QCheckBox  — 어댑티브 on/off
        self.combo_adapt_priority  QComboBox  — Normal / Urgent
    """

    # ─────────────────────────────────────────────────────────
    # UI 빌더  —  _build_quick_order_panel() 의 tif_row 에서 호출
    # ─────────────────────────────────────────────────────────
    def _build_adaptive_ui(self, row):
        """
        row (QHBoxLayout) 에 어댑티브 체크박스 + 녹색 인디케이터 + Normal/Urgent 콤보를 추가한다.
        유형 행(type_h) 에 인라인으로 삽입되도록 설계됨.
        """
        # ── 녹색 인디케이터 원 (체크 시 점등) ───────────────
        self.lbl_adapt_dot = QLabel("●")
        self.lbl_adapt_dot.setFixedWidth(12)
        self.lbl_adapt_dot.setStyleSheet("color:#2a2a4a;font-size:10px;border:none;")

        # ── 체크박스 ─────────────────────────────────────────
        self.chk_adaptive = QCheckBox("어댑티브")
        self.chk_adaptive.setStyleSheet(
            "QCheckBox{color:#a0c4ff;font-size:11px;font-weight:bold;spacing:3px;}"
            "QCheckBox::indicator{width:13px;height:13px;"
            "border:1px solid #4a6a9a;border-radius:2px;background:#0a0a1e;}"
            "QCheckBox::indicator:checked{"
            "background:#3060cc;border:1px solid #60a0ff;}")
        self.chk_adaptive.setToolTip(
            "IBKR Adaptive Algorithm 사용\n"
            "Normal: 체결률 우선  |  Urgent: 속도 우선")

        # ── Normal / Urgent 콤보 ──────────────────────────────
        self.combo_adapt_priority = QComboBox()
        self.combo_adapt_priority.addItems(["Normal", "Urgent"])
        self.combo_adapt_priority.setFixedHeight(22)
        self.combo_adapt_priority.setFixedWidth(64)
        self.combo_adapt_priority.setEnabled(False)
        self.combo_adapt_priority.setStyleSheet(
            "QComboBox{background:#0d0d22;color:#a0c4ff;"
            "border:1px solid #2a4a6a;font-size:10px;padding:1px 3px;}"
            "QComboBox QAbstractItemView{"
            "background:#0d0d22;color:#a0c4ff;font-size:10px;}"
            "QComboBox::drop-down{border:none;width:10px;}"
            "QComboBox:disabled{"
            "color:#4a6a8a;border:1px solid #1a2a4a;background:#08081a;}")

        # 체크 → 콤보 활성 + 인디케이터 점등
        def _on_toggle(checked):
            self.combo_adapt_priority.setEnabled(checked)
            self.lbl_adapt_dot.setStyleSheet(
                "color:#00ff88;font-size:10px;border:none;"   # 녹색 점등
                if checked else
                "color:#2a2a4a;font-size:10px;border:none;")  # 소등

        self.chk_adaptive.toggled.connect(_on_toggle)

        row.addSpacing(4)
        row.addWidget(self.lbl_adapt_dot)
        row.addWidget(self.chk_adaptive)
        row.addWidget(self.combo_adapt_priority)

    # ─────────────────────────────────────────────────────────
    # 주문 로직  —  _qord_place() 에서 placeOrder 직전에 호출
    # ─────────────────────────────────────────────────────────
    def _apply_adaptive(self, ibord) -> bool:
        """
        어댑티브가 체크된 경우 ibord 에 algoStrategy / algoParams 를 설정한다.

        Returns:
            True  — 어댑티브 적용됨
            False — 어댑티브 미사용 (일반 주문)
        """
        if not (getattr(self, 'chk_adaptive', None) and self.chk_adaptive.isChecked()):
            return False

        from ibapi.tag_value import TagValue
        priority = self.combo_adapt_priority.currentText()   # "Normal" | "Urgent"
        ibord.algoStrategy = "Adaptive"
        ibord.algoParams   = [TagValue("adaptivePriority", priority)]
        return True

    # ─────────────────────────────────────────────────────────
    # 표시용 태그 문자열  —  확인 다이얼로그 / 상태바 / 로그에 사용
    # ─────────────────────────────────────────────────────────
    def _adaptive_label(self) -> str:
        """
        어댑티브 체크 여부에 따라 태그 문자열을 반환한다.
        예) " [Adaptive/Normal]"  또는  ""
        """
        if getattr(self, 'chk_adaptive', None) and self.chk_adaptive.isChecked():
            priority = self.combo_adapt_priority.currentText()
            return f" [Adaptive/{priority}]"
        return ""