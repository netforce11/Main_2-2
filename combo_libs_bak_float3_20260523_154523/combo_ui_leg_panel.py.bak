# combo_ui_leg_panel.py  v2.1
# 레그 테이블 빌드·수익 계산 + 스프레드 간격 스핀박스(기본 5) 추가
# 수정: _build_gap_row() → QSpinBox(기본=5) 추가,
#       스프레드 간격 변경 시 LegLogicMixin._on_gap_changed() 연결,
#       _refresh_pnl() 에서 gap 연동 손익분기점 재계산.

from __future__ import annotations
from PyQt5.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel,
    QSpinBox, QTableWidget, QTableWidgetItem,
    QHeaderView, QPushButton,
)
from PyQt5.QtCore import Qt
from combo_ui_leg_logic import LegLogicMixin
from combo_pnl_calc import calc_pnl_breakeven


# ── 상수 ──────────────────────────────────────────────────────────
DEFAULT_GAP = 5
_HEADERS = ["방향", "CP", "행사가", "만기", "수량", "프리미엄", "소계"]


class LegPanelMixin(LegLogicMixin):
    """레그 입력 패널 UI + 손익 계산."""

    # ── 패널 빌드 ──────────────────────────────────────────────────
    def _build_leg_panel(self, parent: QWidget) -> QWidget:
        container = QWidget(parent)
        vbox = QVBoxLayout(container)
        vbox.setContentsMargins(4, 4, 4, 4)
        vbox.setSpacing(4)

        # ① 스프레드 간격 행
        vbox.addWidget(self._build_gap_row(container))

        # ② 레그 테이블
        self._tbl_legs = self._build_legs_table(container)
        vbox.addWidget(self._tbl_legs)

        # ③ PnL 요약 행
        vbox.addWidget(self._build_pnl_row(container))

        return container

    # ── 스프레드 간격 입력 행 ──────────────────────────────────────
    def _build_gap_row(self, parent: QWidget) -> QWidget:
        row = QWidget(parent)
        hbox = QHBoxLayout(row)
        hbox.setContentsMargins(0, 0, 0, 0)

        lbl = QLabel("스프레드 간격 (pt):", row)
        hbox.addWidget(lbl)

        self._spn_gap = QSpinBox(row)
        self._spn_gap.setRange(1, 200)
        self._spn_gap.setValue(DEFAULT_GAP)       # ← 기본값 5
        self._spn_gap.setSuffix(" pt")
        self._spn_gap.setFixedWidth(80)
        self._spn_gap.valueChanged.connect(self._on_gap_spin_changed)
        hbox.addWidget(self._spn_gap)

        hbox.addStretch()
        lbl_hint = QLabel("(버터플라이·스프레드 자동 적용)", row)
        lbl_hint.setStyleSheet("color:#888;font-size:11px;")
        hbox.addWidget(lbl_hint)

        return row

    # ── 간격 스핀박스 변경 핸들러 ──────────────────────────────────
    def _on_gap_spin_changed(self, val: int) -> None:
        self._on_gap_changed(val)          # LegLogicMixin 호출
        self._refresh_pnl()               # PnL 재계산

    # ── 레그 테이블 빌드 ───────────────────────────────────────────
    def _build_legs_table(self, parent: QWidget) -> QTableWidget:
        tbl = QTableWidget(0, len(_HEADERS), parent)
        tbl.setHorizontalHeaderLabels(_HEADERS)
        tbl.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        tbl.setAlternatingRowColors(True)
        tbl.setSelectionBehavior(QTableWidget.SelectRows)
        return tbl

    # ── PnL 요약 행 ────────────────────────────────────────────────
    def _build_pnl_row(self, parent: QWidget) -> QWidget:
        row = QWidget(parent)
        hbox = QHBoxLayout(row)
        hbox.setContentsMargins(0, 0, 0, 0)

        self._lbl_max_profit = QLabel("최대수익: --", row)
        self._lbl_max_loss   = QLabel("최대손실: --", row)
        self._lbl_breakeven  = QLabel("손익분기: --", row)

        for lbl in (self._lbl_max_profit, self._lbl_max_loss, self._lbl_breakeven):
            lbl.setStyleSheet("font-size:12px;font-weight:bold;")
            hbox.addWidget(lbl)

        hbox.addStretch()
        btn = QPushButton("PnL 갱신", row)
        btn.setFixedWidth(80)
        btn.clicked.connect(self._refresh_pnl)
        hbox.addWidget(btn)

        return row

    # ── PnL 재계산 ────────────────────────────────────────────────
    def _refresh_pnl(self) -> None:
        legs = self._collect_legs()
        if not legs:
            return
        try:
            result = calc_pnl_breakeven(legs, self._spread_gap)
        except Exception:
            return
        self._lbl_max_profit.setText(f"최대수익: {result.get('max_profit','--')}")
        self._lbl_max_loss.setText(  f"최대손실: {result.get('max_loss','--')}")
        pts = result.get("breakevens", [])
        be_str = " / ".join(str(p) for p in pts) if pts else "--"
        self._lbl_breakeven.setText(f"손익분기: {be_str}")

    # ── 레그 데이터 수집 ───────────────────────────────────────────
    def _collect_legs(self) -> list[dict]:
        legs = []
        tbl = self._tbl_legs
        for r in range(tbl.rowCount()):
            def cell(c):
                item = tbl.item(r, c)
                return item.text().strip() if item else ""
            try:
                legs.append({
                    "dir":    cell(0),
                    "cp":     cell(1),
                    "strike": float(cell(2)) if cell(2) else None,
                    "expiry": cell(3),
                    "qty":    int(cell(4)) if cell(4) else 1,
                    "prem":   float(cell(5)) if cell(5) else 0.0,
                })
            except ValueError:
                continue
        return legs

    # ── LegLogicMixin 추상 메서드 구현 ────────────────────────────
    def _clear_legs_table(self) -> None:
        self._tbl_legs.setRowCount(0)

    def _append_leg_row(self, t: dict) -> None:
        tbl = self._tbl_legs
        r = tbl.rowCount()
        tbl.insertRow(r)
        for c, val in enumerate([
            t.get("dir",""), t.get("cp",""),
            "" if t.get("strike") is None else str(t["strike"]),
            t.get("expiry",""), str(t.get("qty",1)), "", ""
        ]):
            tbl.setItem(r, c, QTableWidgetItem(val))

    def _get_leg1_strike(self) -> float | None:
        return self._get_leg_strike(0)

    def _get_leg_strike(self, row: int) -> float | None:
        item = self._tbl_legs.item(row, 2)
        if item and item.text().strip():
            try:
                return float(item.text().strip())
            except ValueError:
                pass
        return None

    def _set_leg_strike(self, row: int, strike: float) -> None:
        tbl = self._tbl_legs
        if row >= tbl.rowCount():
            return
        tbl.setItem(row, 2, QTableWidgetItem(str(int(strike))))
