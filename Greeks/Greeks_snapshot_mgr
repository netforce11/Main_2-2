"""greeks_snapshot_mgr.py — IBKR 스냅샷 요청 관리  S12-patch2
════════════════════════════════════════════════════════════════
S12     BUG-2: 0DTE 콜/풋 rid 카운터 분리
S12     BUG-7: queue_done 마지막 슬롯만 발송
S12-patch1: [논리결함1] 재호출 시 cancelMktData 누락 → _cancel_snapshot() 추가
            [심각2]     0DTE reqId 충돌 → snap_mgr 0DTE 스트리밍 제거, 역할 분리
S12-patch2: [pacing 개선]
            ① 고정 주기 타이머(_t1/_t2) 제거
               → 수신 완료(done) 후 QTimer.singleShot 으로 재요청 (방법2)
               → 응답이 지연되더라도 완료 전 cancel 없음, 데이터 유실 방지
            ② 갱신 대기 시간 증가 (방법1)
               +1DTE: 완료 후 2분 대기 (기존 1분 고정 주기)
               D+2  : 완료 후 5분 대기 (기존 2분 고정 주기)
            ③ _cancel_snapshot() 은 start() 최초 1회 / stop() 시만 사용
               정상 갱신 흐름에서는 cancel 없이 완료 후 재요청
"""
from __future__ import annotations
import logging
from datetime import date, timedelta
from typing import Callable, Dict, List, Optional, Tuple

from PyQt5.QtCore import QTimer

log = logging.getLogger(__name__)

# 0DTE 블록은 fetch() 가 단독 사용 (심각2 수정)
REQ_1DTE_C_BASE = 5000;  REQ_1DTE_P_BASE = 5400;  REQ_1DTE_RANGE = 400
REQ_2DTE_C_BASE = 6000;  REQ_2DTE_P_BASE = 6400;  REQ_2DTE_RANGE = 400

PACING_DELAY_MS   = 22         # 초당 45개 (22ms 간격)
# patch2: 고정 주기 타이머 → 완료 후 대기 시간으로 변경
SNAP_1DTE_WAIT_MS = 120_000    # +1DTE 완료 후 재요청 대기: 2분
SNAP_2DTE_WAIT_MS = 300_000    # D+2   완료 후 재요청 대기: 5분

StatusFn = Optional[Callable[[int, str, int, str], None]]


class SnapshotManager:
    """
    만기별 IBKR 스냅샷 요청 관리.
    역할: +1DTE / +2DTE 스냅샷 전담.
    0DTE 스트리밍은 fetch() / tab_greeks_fetch.py 가 단독 담당.

    갱신 방식 (patch2):
      고정 타이머 방식 → 수신 완료 후 N분 뒤 재요청 방식으로 변경.
      응답이 지연되더라도 완료 전에 cancel 하지 않으므로 데이터 유실 없음.
    """

    def __init__(self, ib, make_contract_fn, on_data_fn, on_status_fn: StatusFn = None):
        self._ib        = ib
        self._make_con  = make_contract_fn
        self._on_data   = on_data_fn       # 현재 미사용 (on_tick_opt 경로로 처리됨)
        self._on_status = on_status_fn
        self._req_map: Dict[int, Tuple[str, float, str]] = {}

        # patch2: 고정 주기 _t1/_t2 제거 → _retry_t1/_retry_t2 singleShot 으로 대체
        self._queue: List[Tuple] = []
        self._pace_t = QTimer(); self._pace_t.setInterval(PACING_DELAY_MS)
        self._pace_t.timeout.connect(self._send_one)

        self._sym   = ""; self._und = 0.0
        self._exp_0 = ""; self._exp_1 = ""; self._exp_2 = ""
        self._last_queued_slot: int = -1
        self._recv_count  = [0, 0, 0]
        self._total_count = [0, 0, 0]

        # patch2: 재요청 대기 타이머 핸들 (stop() 시 취소용)
        self._retry_t1: Optional[QTimer] = None
        self._retry_t2: Optional[QTimer] = None

        # 실행 중 여부 플래그 (stop() 후 singleShot 콜백 방어)
        self._running = False

    # ── 공개 API ─────────────────────────────────────────────────────────────

    def start(self, sym: str, und_price: float, expiry_0dte: str = "",
              expiry_1dte: str = "", expiry_2dte: str = ""):
        """
        +1DTE / +2DTE 스냅샷 시작.
        expiry_0dte 는 슬롯 매핑(_slot_for_expiry)용으로만 보관.
        스트리밍 요청은 fetch() 가 담당하므로 여기서 하지 않음.
        """
        self._sym   = sym;  self._und = und_price
        self._exp_0 = expiry_0dte
        self._exp_1 = expiry_1dte or self._next_bday(1)
        self._exp_2 = expiry_2dte or self._next_bday(2)
        self._running = True
        log.info("[SnapMgr] start %s und=%.1f +1=%s +2=%s (0DTE=%s, fetch 담당)",
                 sym, und_price, self._exp_1, self._exp_2, self._exp_0)
        # 최초 즉시 요청 (이후는 완료 → singleShot 대기 → 재요청)
        self._snap_1dte()
        self._snap_2dte()

    def stop(self):
        """전체 정지 — 진행 중 재요청 대기 타이머도 취소."""
        self._running = False
        self._pace_t.stop()
        self._queue.clear()
        # 재요청 대기 타이머 취소
        if self._retry_t1:
            self._retry_t1.stop(); self._retry_t1 = None
        if self._retry_t2:
            self._retry_t2.stop(); self._retry_t2 = None
        # 관할 rid 전체 cancel (1DTE/2DTE 블록만)
        for rid in list(self._req_map.keys()):
            try: self._ib.cancelMktData(rid)
            except Exception: pass
        self._req_map.clear()
        log.info("[SnapMgr] 전체 정지")

    def update_und_price(self, price: float):
        self._und = price

    def get_req_info(self, rid: int) -> Optional[Tuple[str, float, str]]:
        return self._req_map.get(rid)

    def is_managed_req(self, rid: int) -> bool:
        return rid in self._req_map

    def record_received(self, rid: int):
        """
        tick 수신 시 tab_greeks_tick 에서 호출 → 카운터 증가 + 신호등 갱신.
        patch2: 수신 완료(n >= total) 시 고정 타이머 대신 singleShot 으로 재요청 예약.
        """
        info = self._req_map.get(rid)
        if not info: return
        slot = self._slot_for_expiry(info[0])
        if slot < 0: return

        self._recv_count[slot] += 1
        n     = self._recv_count[slot]
        total = self._total_count[slot]

        _saving = ("당일 만기 저장 중…", "+1DTE 저장 중…", "D+2 저장 중…")
        _done   = ("당일 만기 수신 완료", "+1DTE 저장 완료", "D+2 저장 완료")

        if total > 0 and n >= total:
            self._notify(slot, "done", _done[slot])
            # patch2 핵심: 완료 확인 후 대기 → 재요청 예약
            if self._running:
                self._schedule_retry(slot)
        elif n == 1 or n % 10 == 0:
            self._notify(slot, "saving", _saving[slot])

    # ── 내부 ─────────────────────────────────────────────────────────────────

    def _schedule_retry(self, slot: int):
        """
        수신 완료 후 슬롯별 대기 시간 뒤 재요청 singleShot 예약.
        이전 대기 타이머가 남아있으면 먼저 취소 후 교체.
        """
        if slot == 1:
            if self._retry_t1:
                self._retry_t1.stop()
            t = QTimer(); t.setSingleShot(True)
            t.timeout.connect(self._snap_1dte)
            t.start(SNAP_1DTE_WAIT_MS)
            self._retry_t1 = t
            log.info("[SnapMgr] +1DTE 재요청 예약 (%.0f초 후)",
                     SNAP_1DTE_WAIT_MS / 1000)
        elif slot == 2:
            if self._retry_t2:
                self._retry_t2.stop()
            t = QTimer(); t.setSingleShot(True)
            t.timeout.connect(self._snap_2dte)
            t.start(SNAP_2DTE_WAIT_MS)
            self._retry_t2 = t
            log.info("[SnapMgr] D+2 재요청 예약 (%.0f초 후)",
                     SNAP_2DTE_WAIT_MS / 1000)

    def _notify(self, slot: int, event: str, label: str = ""):
        if self._on_status:
            try: self._on_status(slot, event, self._recv_count[slot], label)
            except Exception as e: log.warning("[SnapMgr] on_status_fn 오류: %s", e)

    def _slot_for_expiry(self, expiry: str) -> int:
        if expiry == self._exp_0: return 0
        if expiry == self._exp_1: return 1
        if expiry == self._exp_2: return 2
        return -1

    def _cancel_snapshot(self, c_base: int, p_base: int, max_range: int):
        """
        해당 슬롯 rid 블록 전체 cancel + req_map 에서 제거.
        start() 최초 호출 및 stop() 시에만 사용.
        정상 갱신 흐름(완료 후 재요청)에서는 호출하지 않음.
        """
        for base in (c_base, p_base):
            for i in range(max_range):
                rid = base + i
                if rid in self._req_map:
                    try: self._ib.cancelMktData(rid)
                    except Exception: pass
                    del self._req_map[rid]

    def _snap_1dte(self):
        if not self._exp_1 or not self._running: return
        # 잔존 rid 정리 (비정상 경로 방어 — 정상 흐름에선 req_map 이 비어있음)
        self._cancel_snapshot(REQ_1DTE_C_BASE, REQ_1DTE_P_BASE, REQ_1DTE_RANGE)
        self._recv_count[1] = 0
        cnt = self._request_snapshot(self._exp_1,
                                     REQ_1DTE_C_BASE, REQ_1DTE_P_BASE,
                                     REQ_1DTE_RANGE, "wing_1dte", "+1DTE", slot=1)
        self._total_count[1] = cnt
        self._notify(1, "saving", f"+1DTE 조회 중… ({cnt}건)")

    def _snap_2dte(self):
        if not self._exp_2 or not self._running: return
        self._cancel_snapshot(REQ_2DTE_C_BASE, REQ_2DTE_P_BASE, REQ_2DTE_RANGE)
        self._recv_count[2] = 0
        cnt = self._request_snapshot(self._exp_2,
                                     REQ_2DTE_C_BASE, REQ_2DTE_P_BASE,
                                     REQ_2DTE_RANGE, "wing_2dte", "+2DTE", slot=2)
        self._total_count[2] = cnt
        self._notify(2, "saving", f"D+2 조회 중… ({cnt}건)")

    def _request_snapshot(self, expiry, c_base, p_base, max_range,
                          wing_key, label, slot: int) -> int:
        cfg = self._symbol_cfg()
        count = 0
        for i, strike in enumerate(
                self._strikes(self._und, cfg[wing_key], cfg["step"])):
            for side in ("C", "P"):
                base = c_base if side == "C" else p_base
                rid  = base + i
                if rid >= base + max_range:
                    log.warning("[SnapMgr] %s reqId 초과", label); break
                con = self._make_con(self._sym, strike, side, expiry, "")
                self._enqueue(rid, con, snapshot=True, slot=slot)
                self._req_map[rid] = (expiry, strike, side)
                count += 1
        if not self._pace_t.isActive():
            self._pace_t.start()
        log.info("[SnapMgr] %s 스냅샷 큐 %d건 (만기=%s)", label, count, expiry)
        return count

    def _enqueue(self, rid: int, contract, snapshot: bool, slot: int):
        self._queue.append((rid, contract, snapshot, slot))

    def _send_one(self):
        if not self._queue:
            self._pace_t.stop()
            # BUG-7 수정(S12): 마지막으로 전송한 슬롯만 queue_done 발송
            if self._last_queued_slot >= 0:
                s = self._last_queued_slot
                self._notify(s, "queue_done",
                             f"전송 완료 ({self._total_count[s]}건 요청)")
                self._last_queued_slot = -1
            return
        rid, contract, snapshot, slot = self._queue.pop(0)
        self._last_queued_slot = slot
        try: self._ib.reqMktData(rid, contract, "", snapshot, False, [])
        except Exception as e:
            log.error("[SnapMgr] reqMktData 실패 rid=%d: %s", rid, e)

    def _symbol_cfg(self) -> dict:
        _CFG = {
            "SPX": {"step": 5,  "wing_0dte": 8,  "wing_1dte": 30, "wing_2dte": 20},
            "NDX": {"step": 25, "wing_0dte": 6,  "wing_1dte": 20, "wing_2dte": 15},
            "SPY": {"step": 1,  "wing_0dte": 10, "wing_1dte": 40, "wing_2dte": 30},
            "QQQ": {"step": 1,  "wing_0dte": 10, "wing_1dte": 40, "wing_2dte": 30},
        }
        return _CFG.get(self._sym,
                        {"step": 5, "wing_0dte": 8,
                         "wing_1dte": 30, "wing_2dte": 20})

    @staticmethod
    def _strikes(und: float, wing: int, step: int) -> List[float]:
        atm = round(und / step) * step
        return [atm + i * step for i in range(-wing, wing + 1)]

    @staticmethod
    def _next_bday(n: int) -> str:
        d = date.today(); count = 0
        while count < n:
            d += timedelta(days=1)
            if d.weekday() < 5: count += 1
        return d.strftime("%Y%m%d")